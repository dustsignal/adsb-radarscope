# ADSB Radarscope v2 — build-time environment variables (Vite).
# Copy to ".env" and adjust for your deployment, then run `npm run build`.
# The interactive `python build.py` flow writes runtime-config.json instead;
# its first-run feed setting takes precedence over this fallback.

# Default aircraft data feed (tar1090 / dump1090 aircraft.json endpoint).
# Leave unset to use the same-origin fallback "/tar1090/data/aircraft.json".
# Examples:
#   VITE_DATA_URL=http://<your-receiver-host>/tar1090/data/aircraft.json
#   VITE_DATA_URL=/tar1090/data/aircraft.json
VITE_DATA_URL=
